{
  "name": "acceptance-tests",
  "private": true,
  "version": "0.0.0",
  "description": "Cucumber-js acceptance suite: extracts the Gherkin specs under openspec/ and runs the effective spec against a fresh Docker Compose stack.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cucumber-js",
    "test:specs": "cucumber-js -p specs",
    "lint:specs": "node extract-gherkin.cjs && gherkin-lint .extracted"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@playwright/test": "1.63.0",
    "cheerio": "1.2.0",
    "gherkin-lint": "4.2.4",
    "glob": "13.0.6"
  }
}
